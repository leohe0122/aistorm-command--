# AIStorm Command 运行配置（只列变量名与说明，不要在此文件填写真实值）
# 复制为 .env 或写入进程管理器 / 容器的环境变量。详见 docs/DEPLOY.md。

# ── 必需 ──────────────────────────────────────────────────────────────
# 运行模式；生产必须为 production（缺少必需项时会直接退出并列出变量名）
NODE_ENV=
# 监听端口，反向代理转发到这里（默认 3000）
PORT=
# MySQL 8 连接串：mysql://用户:密码@主机:3306/库名
DATABASE_URL=
# 至少 32 位随机字符串（openssl rand -hex 32），用于文件限时签名链接
JWT_SECRET=
# 文件存储：local 或 s3
STORAGE_DRIVER=

# ── 存储：STORAGE_DRIVER=local ─────────────────────────────────────────
# 本地上传目录（默认 ./data/uploads），放在会备份的磁盘上
STORAGE_LOCAL_DIR=

# ── 存储：STORAGE_DRIVER=s3（S3 兼容：AWS S3 / R2 / MinIO / OSS 等）──────
S3_BUCKET=
S3_REGION=
# 非 AWS 时填写服务地址，如 https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# 不填时使用 AWS SDK 默认凭证链（实例角色等）
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO 等需要路径风格时设为 true
S3_FORCE_PATH_STYLE=
# 对象键前缀（可选）
S3_PREFIX=

# ── 推荐 ──────────────────────────────────────────────────────────────
# 对外访问地址，如 https://command.aistorm.com（飞书消息中的登录链接、文档预览链接）
PUBLIC_APP_URL=
# 定时任务接口凭证（openssl rand -hex 32）；未设置时 /api/scheduled/* 停用。见 docs/定时任务.md
CRON_SECRET=

# ── 可选 ──────────────────────────────────────────────────────────────
# 飞书机器人（暂保留，后续接入）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# 管理员通知 Webhook（也可在 系统设置 → 可选服务 中配置）
NOTIFY_WEBHOOK_URL=

# 注意：AI 模型 Key 不通过环境变量配置。部署后由管理员在 系统设置 → AI 模型配置 中填写，
# 每个部署使用自己的 Key；服务不会读取 OPENAI_API_KEY。
